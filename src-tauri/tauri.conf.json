{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Leaflyte",
  "version": "0.3.0",
  "identifier": "com.leaflyte.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node scripts/copy-monaco.mjs && npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Leaflyte",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#16171B",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMDY3MjY2NUQxMTI3MEUKUldRT0p4RmRabklHazJ1a3BpOGlkc085Zi9pbXY0SDRNeWthK203NUxPdGM2dmdsUDZVTGM1VkEK",
      "endpoints": ["https://leaflyte.app/updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
